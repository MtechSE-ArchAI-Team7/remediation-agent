ARG CODE_INTERPRETER_PLATFORM=linux/amd64
FROM --platform=${CODE_INTERPRETER_PLATFORM} node:20.19.5-bookworm AS validation-build
WORKDIR /build
COPY validation/ecommerce/package.json validation/ecommerce/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund && \
    npm rebuild sqlite3 bcrypt --build-from-source --nodedir=/usr/local
COPY scripts/seal_validation_bundle.py /build/seal_validation_bundle.py
RUN python3 seal_validation_bundle.py /build /bundle /usr/local/bin/node && \
    NODE_PATH=/bundle/node_modules /bundle/node -e "require('express'); require('sqlite3'); require('bcrypt')"

FROM ghcr.io/astral-sh/uv:python3.12-trixie-slim AS builder

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable
COPY config ./config
RUN uv pip install --target /app/validation/pytest_vendor "pytest==8.4.2" && \
    /app/.venv/bin/python -c "import tarfile; archive = tarfile.open('/app/validation/pytest_vendor.tar.gz', 'w:gz'); archive.add('/app/validation/pytest_vendor', arcname='.'); archive.close(); tarfile.open('/app/validation/pytest_vendor.tar.gz', 'r:gz').getmembers()"
RUN /app/.venv/bin/python -c "from remediation_agent.api.a2a import create_a2a_app; assert callable(create_a2a_app)"

FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app
RUN apt-get update && \
    apt-get install --yes --no-install-recommends ca-certificates git && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 10001 --create-home remediation
COPY --from=builder --chown=10001:10001 /app /app
COPY --from=validation-build --chown=10001:10001 /bundle /app/validation/ecommerce
ENV AIOS_BEHAVIORAL_BUNDLE=/app/validation/ecommerce
USER 10001:10001

EXPOSE 9000
CMD ["uvicorn", "remediation_agent.api.a2a:app", "--host", "0.0.0.0", "--port", "9000"]
