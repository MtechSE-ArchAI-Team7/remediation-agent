ARG CODE_INTERPRETER_PLATFORM=linux/arm64
FROM --platform=${CODE_INTERPRETER_PLATFORM} node:24-bookworm AS validation-build
WORKDIR /build
COPY validation/ecommerce/package.json validation/ecommerce/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && \
    npm rebuild sqlite3 bcrypt --build-from-source --nodedir=/usr/local
COPY validation/browser/package.json validation/browser/package-lock.json /build/browser-runner/
RUN cd /build/browser-runner && npm ci --ignore-scripts --no-audit --no-fund
ENV PLAYWRIGHT_BROWSERS_PATH=/build/browser-cache
COPY scripts/seal_browser_bundle.py scripts/seal_validation_bundle.py /build/
RUN rm -rf /var/lib/apt/lists/* && \
    node browser-runner/node_modules/playwright-core/cli.js install --with-deps --only-shell chromium && \
    python3 seal_browser_bundle.py /build/browser-cache /build/browser.tar.xz && \
    python3 seal_validation_bundle.py /build /bundle /usr/local/bin/node && \
    NODE_PATH=/bundle/node_modules /bundle/node -e "require('express'); require('sqlite3'); require('bcrypt')" && \
    rm -rf /build/browser-cache /build/browser.tar.xz /root/.npm /var/lib/apt/lists/*

# Keep the builder and runtime on the same patched glibc/Python distribution.
FROM cgr.dev/chainguard/wolfi-base@sha256:c2a4815b6ca49b9bbafd451b4bde690d567a86b2b6b54877faac8082a7bc4296 AS runtime-base
# Refresh inherited packages too, and fail the build if advisory fixes are unavailable.
RUN apk upgrade --no-cache && \
    apk add --no-cache python-3.12 git libstdc++ \
        'ca-certificates-bundle>=20260909-r3' \
        'libbrotlicommon1>=1.2.0-r7' \
        'libbrotlidec1>=1.2.0-r7' \
        'libbrotlienc1>=1.2.0-r7' && \
    addgroup -g 10001 remediation && \
    adduser -D -u 10001 -G remediation remediation

FROM runtime-base AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11.25@sha256:1e3808aa9023d0980e7c15b1fa7c1ac16ff35925780cf5c459858b2d693f01a9 /uv /uvx /usr/local/bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable
COPY config ./config
COPY scripts/qualify_workflow.py /app/scripts/qualify_workflow.py
RUN uv pip install --target /app/validation/pytest_vendor "pytest==9.1.1" && \
    /app/.venv/bin/python -c "import tarfile; archive = tarfile.open('/app/validation/pytest_vendor.tar.gz', 'w:gz'); archive.add('/app/validation/pytest_vendor', arcname='.'); archive.close(); tarfile.open('/app/validation/pytest_vendor.tar.gz', 'r:gz').getmembers()"
RUN /app/.venv/bin/python -c "from remediation_agent.api.a2a import create_a2a_app; assert callable(create_a2a_app)"

FROM runtime-base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app
COPY --from=builder --chown=10001:10001 /app /app
COPY --from=validation-build --chown=10001:10001 /bundle /app/validation/ecommerce
ENV AIOS_BEHAVIORAL_BUNDLE=/app/validation/ecommerce
USER 10001:10001
RUN /app/.venv/bin/python -c "from remediation_agent.api.a2a import create_a2a_app; assert callable(create_a2a_app)" && \
    git --version && /app/validation/ecommerce/node --version

EXPOSE 9000
CMD ["uvicorn", "remediation_agent.api.a2a:app", "--host", "0.0.0.0", "--port", "9000"]
