# Copy to .env for local development. Never commit real values.
POSTGRES_DB=remediation
POSTGRES_USER=remediation
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
AIOS_POSTGRES_DSN=
AIOS_CHECKPOINT_ENCRYPTION_KEY=
AIOS_POLICY_FILE=config/policies/reference.json
AIOS_LLM_PROVIDER=bedrock
AIOS_LLM_MODEL=
AIOS_AWS_REGION=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AIOS_OPENAI_BASE_URL=
AIOS_DEEPSEEK_BASE_URL=
# Required for hosted GitHub MCP inspection; also used for private clone and optional push/PR.
# Use the narrowest repository-scoped token that covers the configured workflow.
AIOS_GITHUB_TOKEN=
# Required with AIOS_GITHUB_WRITES_ENABLED=true and must match the handoff repository.
AIOS_GITHUB_REPOSITORY=
AIOS_GITHUB_WRITES_ENABLED=false
# AgentCore-only non-secret identifiers. The PAT and checkpoint key stay in Secrets Manager.
AIOS_AGENTCORE_MEMORY_ID=
AIOS_RUNTIME_SECRET_ARN=
AIOS_ARTIFACT_BUCKET=
AIOS_CODE_INTERPRETER_IDENTIFIER=aws.codeinterpreter.v1
AIOS_CODE_INTERPRETER_BUNDLE=/app/validation/pytest_vendor.tar.gz
AIOS_INVOCATION_TIMEOUT_SECONDS=840
