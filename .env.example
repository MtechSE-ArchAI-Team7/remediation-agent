# Copy to .env for local development. Never commit real values.
POSTGRES_DB=remediation
POSTGRES_USER=remediation
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
AIOS_POSTGRES_DSN=
AIOS_CHECKPOINT_ENCRYPTION_KEY=
AIOS_POLICY_FILE=config/policies/reference.json
AIOS_LLM_PROVIDER=bedrock
AIOS_LLM_MODEL=
# Optional, non-gating assessment judge. All three values are required by `make evaluate-judge`.
AIOS_EVAL_JUDGE_PROVIDER=
AIOS_EVAL_JUDGE_MODEL=
AIOS_EVAL_JUDGE_PROMPT_VERSION=
AIOS_AWS_REGION=
# OpenAI authentication: api_key (default) or aws_iam_gateway.
AIOS_OPENAI_AUTH_MODE=api_key
OPENAI_API_KEY=
# Direct hosted OpenAI mode loads this secret instead of accepting an inline API key.
AIOS_OPENAI_SECRET_ARN=
# IAM gateway mode requires this ARN and forbids all three API-key/base-URL settings.
AIOS_OPENAI_GATEWAY_ARN=
DEEPSEEK_API_KEY=
AIOS_OPENAI_BASE_URL=
AIOS_DEEPSEEK_BASE_URL=
# Required for hosted GitHub MCP inspection; also used for private clone, optional Git push, and deterministic MCP PR publication.
# Use the narrowest repository-scoped token that covers the configured workflow.
AIOS_GITHUB_TOKEN=
# Repository inspection uses GitHub directly by default. Gateway mode additionally requires AWS Region and ARN.
AIOS_INSPECTION_MCP_MODE=github_direct
AIOS_INSPECTION_GATEWAY_ARN=
# Required with AIOS_GITHUB_WRITES_ENABLED=true and must match the handoff repository.
AIOS_GITHUB_REPOSITORY=
AIOS_GITHUB_WRITES_ENABLED=false
# AgentCore-only non-secret identifiers. The PAT and checkpoint key stay in Secrets Manager.
AIOS_AGENTCORE_MEMORY_ID=
# Optional advisory incident memory. This must be a dedicated resource, not the checkpoint memory above.
AIOS_INCIDENT_MEMORY_ENABLED=false
AIOS_INCIDENT_MEMORY_WRITES_ENABLED=false
AIOS_INCIDENT_MEMORY_ID=
AIOS_INCIDENT_MEMORY_STRATEGY_ID=
AIOS_INCIDENT_MEMORY_NAMESPACE=/aios/incidents/
AIOS_RUNTIME_SECRET_ARN=
AIOS_ARTIFACT_BUCKET=
AIOS_A2A_TASK_STORE_PREFIX=a2a/tasks
AIOS_A2A_TASK_STORE_MAX_BYTES=524288
AIOS_CODE_INTERPRETER_IDENTIFIER=aws.codeinterpreter.v1
AIOS_CODE_INTERPRETER_BUNDLE=/app/validation/pytest_vendor.tar.gz
AIOS_INVOCATION_TIMEOUT_SECONDS=840
# Guarded AgentCore deployment values. Keep blank for local execution; do not hand-edit in the hosted runtime.
AIOS_RELEASE_ID=
AIOS_RELEASE_SOURCE_SHA=
AIOS_RELEASE_IMAGE_DIGEST=
AIOS_AGENTCORE_RUNTIME_ID=
AIOS_RELEASE_EXPECTED_ACCOUNT_ID=734849394833
AIOS_RELEASE_MAX_RUNTIME_VERSIONS=100
# Optional supplementary Agent 4 delivery. Disabled until a compatible runtime exists.
AIOS_AGENT4_DELIVERY_ENABLED=false
AIOS_AGENT4_RUNTIME_ARN=
AIOS_AGENT4_REGION=
AIOS_AGENT4_QUALIFIER=DEFAULT
AIOS_AGENT4_TIMEOUT_SECONDS=30

# Sealed offline Express/SQLite/native Node bundle; build outside remediation runs.
AIOS_BEHAVIORAL_BUNDLE=.artifacts/validation/ecommerce

# Disposable validation staging must remain outside the managed workspace mount.
AIOS_VALIDATION_SCRATCH_ROOT=/tmp/aios-validation
