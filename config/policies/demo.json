{
  "policy_id": "aios-remediation-ecommerce-demo-v1",
  "version": "1.0",
  "repositories": {
    "allowed_providers": [
      "GITHUB"
    ],
    "allowed_url_patterns": [
      "https://github.com/MtechSE-ArchAI-Team7/buggy-ecommerce-demo.git"
    ]
  },
  "paths": {
    "autonomous": [
      "server.js",
      "public/app.js",
      "lib/**",
      "tests/**"
    ],
    "approval_required": [
      ".github/workflows/**",
      "Dockerfile",
      "docker/**",
      "compose.yaml",
      "pyproject.toml",
      "uv.lock",
      "requirements*.txt",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "migrations/**",
      "**/migrations/**",
      "**/auth/**",
      "**/*auth*.py",
      "**/security/**",
      "**/iam/**",
      "*iam*.json",
      "*.tf",
      "**/*.tf",
      "k8s/**",
      "**/k8s/**",
      "kubernetes/**",
      "**/kubernetes/**",
      "helm/**",
      "**/helm/**",
      "**/Chart.yaml"
    ],
    "forbidden": [
      ".git",
      ".git/**",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "*.pem",
      "**/*.pem",
      "*.key",
      "**/*.key",
      "credentials*",
      "**/credentials*",
      "secrets/**",
      "**/secrets/**"
    ]
  },
  "limits": {
    "autonomous_max_changed_files": 5,
    "absolute_max_changed_files": 10,
    "autonomous_max_diff_lines": 400,
    "absolute_max_diff_lines": 800,
    "max_validation_attempts": 3,
    "max_model_format_retries": 2,
    "max_tree_entries": 500,
    "max_file_bytes": 65536,
    "max_search_results": 50,
    "max_context_bytes": 262144,
    "max_inspection_rounds": 14,
    "max_inspection_tool_calls": 16,
    "max_mcp_tool_timeout_seconds": 30,
    "max_task_timeout_seconds": 300,
    "max_task_output_bytes": 1048576,
    "max_validation_tasks_per_attempt": 6,
    "max_model_output_tokens": 8192,
    "max_active_runs": 4,
    "max_edit_proposals": 3
  },
  "default_validation_tasks": [
    "javascript_syntax"
  ],
  "validation_tasks": {
    "javascript_syntax": {
      "argv": [
        "node",
        "--check",
        "server.js"
      ],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 65536,
      "retryable": false,
      "source_syntax": "javascript"
    },
    "average_regression": {
      "argv": [
        "node",
        "--test",
        "tests/calculate-average.test.js"
      ],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 262144,
      "retryable": false,
      "kind": "BEHAVIORAL",
      "profile": "node_test",
      "test_paths": [
        "tests/calculate-average.test.js"
      ]
    },
    "discount_regression": {
      "argv": [
        "node",
        "--test",
        "tests/discount.test.js"
      ],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 262144,
      "retryable": false,
      "kind": "BEHAVIORAL",
      "profile": "node_test",
      "test_paths": [
        "tests/discount.test.js"
      ]
    },
    "checkout_regression": {
      "argv": [
        "node",
        "--test",
        "tests/checkout.test.js"
      ],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 262144,
      "retryable": false,
      "kind": "BEHAVIORAL",
      "profile": "ecommerce_checkout",
      "test_paths": [],
      "required_test_ids": [
        "checkout_persists_before_success",
        "checkout_server_priced_multiple_products",
        "checkout_invalid_carts",
        "checkout_write_failure_no_success",
        "checkout_restart_persistence",
        "checkout_browser_confirmed_success",
        "checkout_browser_http_failure",
        "checkout_browser_network_failure",
        "checkout_catalog_regression"
      ],
      "required_evidence_paths": [
        "server.js",
        "schema.sql",
        "seed.sql",
        "public/app.js",
        "public/index.html",
        "package.json"
      ],
      "request_contract": {
        "method": "POST",
        "path": "/checkout",
        "content_type": "application/json",
        "field_types": {
          "cart": "array-with-safe-integer-product-id"
        },
        "example_body": "{\"cart\":[{\"id\":1,\"price\":0}]}",
        "expected_responses": [
          "200: {message: \"Order placed\", itemCount: cart.length} after persisted server-priced order",
          "4xx JSON error for invalid or unknown carts",
          "non-200 JSON error on failed order insert"
        ],
        "state_changes": [
          "Persist one orders row with total calculated from server prices before success; retain orders across restart; no persistence on invalid cart or write failure.",
          "Browser retains cart on pending/failed requests and clears it only after confirmed success."
        ],
        "prerequisites": [
          "Disposable ecommerce.db initialized from schema.sql and seed.sql with two products priced at 11.25 and 7.50; real storefront, offline Chromium and real SQLite."
        ],
        "evidence_paths": [
          "server.js",
          "schema.sql",
          "seed.sql",
          "public/app.js",
          "public/index.html",
          "package.json"
        ]
      },
      "assertions": {
        "checkout_persists_before_success": "A one-product numeric-ID cart returns the existing 200 {message: Order placed, itemCount: 1} only after an orders row is persisted using server prices; no status literal is required.",
        "checkout_server_priced_multiple_products": "Two distinct products total 18.75 from database prices, ignoring submitted prices; itemCount equals cart length.",
        "checkout_invalid_carts": "Missing, empty, malformed, non-array, null-entry, string-ID, fractional-ID, negative-ID and unknown-ID carts return a 4xx client error without persisting an order.",
        "checkout_write_failure_no_success": "SQLite insert rejection never returns success or creates an order.",
        "checkout_restart_persistence": "Persisted orders survive application restart with the same database.",
        "checkout_browser_confirmed_success": "Real storefront keeps cart and suppresses success until actual checkout response; clears cart and shows success only after persistence.",
        "checkout_browser_http_failure": "Actual SQLite write failure causes HTTP error; browser retains cart and never shows success.",
        "checkout_browser_network_failure": "A failed checkout network request retains cart and never shows success.",
        "checkout_catalog_regression": "Existing product catalog and storefront remain available."
      },
      "limitations": [
        "No order-status literal is imposed.",
        "Email delivery, user association, line items, inventory changes and idempotency are outside this checkout profile.",
        "Deployment and runtime soak remain pending Agent 4 verification."
      ],
      "repository_patterns": [
        "https://github.com/MtechSE-ArchAI-Team7/buggy-ecommerce-demo",
        "https://github.com/MtechSE-ArchAI-Team7/buggy-ecommerce-demo.git"
      ],
      "regression_test_ids": [
        "checkout_catalog_regression"
      ]
    },
    "shipping_regression": {
      "argv": [
        "node",
        "--test",
        "tests/shipping.test.js"
      ],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 262144,
      "retryable": false,
      "kind": "BEHAVIORAL",
      "profile": "node_test",
      "test_paths": [
        "tests/shipping.test.js"
      ]
    },
    "purchase_regression": {
      "argv": [
        "node",
        "--test",
        "tests/purchase.test.js"
      ],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 262144,
      "retryable": false,
      "kind": "BEHAVIORAL",
      "profile": "ecommerce_purchase",
      "test_paths": [],
      "required_test_ids": [
        "purchase_below_stock",
        "purchase_equal_stock",
        "purchase_above_stock",
        "purchase_invalid_inputs",
        "purchase_form_encoding",
        "purchase_unknown_product",
        "purchase_persistence",
        "purchase_concurrent",
        "purchase_catalog_regression"
      ],
      "required_evidence_paths": [
        "server.js",
        "schema.sql",
        "seed.sql",
        "public/app.js",
        "public/index.html",
        "package.json"
      ],
      "request_contract": {
        "method": "POST",
        "path": "/purchase",
        "content_type": "application/json",
        "field_types": {
          "productId": "safe-integer",
          "quantity": "positive-safe-integer"
        },
        "example_body": "{\"productId\":1,\"quantity\":1}",
        "expected_responses": [
          "200: {success: true, remaining: number}",
          "400: {error: \"Insufficient inventory\"} for insufficient stock or unknown product",
          "400: {error: \"Invalid product ID or quantity\"} for invalid fields and form encoding"
        ],
        "state_changes": [
          "Persist decremented inventory in SQLite; never oversell."
        ],
        "prerequisites": [
          "Disposable ecommerce.db initialized from schema.sql and seed.sql; product 1 starts with inventory 10."
        ],
        "evidence_paths": [
          "server.js",
          "schema.sql",
          "seed.sql",
          "public/app.js",
          "public/index.html",
          "package.json"
        ]
      },
      "assertions": {
        "purchase_below_stock": "purchase below stock",
        "purchase_equal_stock": "purchase equal stock",
        "purchase_above_stock": "purchase above stock",
        "purchase_invalid_inputs": "purchase invalid inputs",
        "purchase_form_encoding": "purchase form encoding",
        "purchase_unknown_product": "purchase unknown product",
        "purchase_persistence": "purchase persistence",
        "purchase_concurrent": "purchase concurrent",
        "purchase_catalog_regression": "Existing product catalog and storefront remain available; an unchanged baseline failure is reported separately from remediation acceptance."
      },
      "limitations": [],
      "repository_patterns": [
        "https://github.com/MtechSE-ArchAI-Team7/buggy-ecommerce-demo",
        "https://github.com/MtechSE-ArchAI-Team7/buggy-ecommerce-demo.git"
      ],
      "regression_test_ids": [
        "purchase_catalog_regression"
      ]
    }
  },
  "mandatory_tasks": [
    {
      "path_patterns": [
        "*.js",
        "*.cjs",
        "*.mjs",
        "**/*.js",
        "**/*.cjs",
        "**/*.mjs"
      ],
      "task_names": [
        "javascript_syntax"
      ]
    },
    {
      "path_patterns": [
        "tests/calculate-average.test.js"
      ],
      "task_names": [
        "average_regression"
      ]
    },
    {
      "path_patterns": [
        "tests/discount.test.js"
      ],
      "task_names": [
        "discount_regression"
      ]
    },
    {
      "path_patterns": [
        "tests/checkout.test.js"
      ],
      "task_names": [
        "checkout_regression"
      ]
    },
    {
      "path_patterns": [
        "tests/shipping.test.js"
      ],
      "task_names": [
        "shipping_regression"
      ]
    },
    {
      "path_patterns": [
        "tests/purchase.test.js"
      ],
      "task_names": [
        "purchase_regression"
      ]
    }
  ],
  "artifacts": {
    "retention_days": 7,
    "write_audit_jsonl": true,
    "include_full_diff": true
  },
  "github": {
    "writes_enabled": true
  },
  "incident_memory": {
    "writes_enabled": false
  }
}
