{
  "policy_id": "aios-remediation-ecommerce-demo-v1",
  "version": "1.0",
  "repositories": {
    "allowed_providers": ["GITHUB"],
    "allowed_url_patterns": [
      "https://github.com/MtechSE-ArchAI-Team7/buggy-ecommerce-demo.git"
    ]
  },
  "paths": {
    "autonomous": [
      "server.js",
      "lib/**",
      "tests/**"
    ],
    "approval_required": [
      ".github/workflows/**",
      "Dockerfile",
      "docker/**",
      "compose.yaml",
      "pyproject.toml",
      "uv.lock",
      "requirements*.txt",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "migrations/**",
      "**/migrations/**",
      "**/auth/**",
      "**/*auth*.py",
      "**/security/**",
      "**/iam/**",
      "*iam*.json",
      "*.tf",
      "**/*.tf",
      "k8s/**",
      "**/k8s/**",
      "kubernetes/**",
      "**/kubernetes/**",
      "helm/**",
      "**/helm/**",
      "**/Chart.yaml"
    ],
    "forbidden": [
      ".git",
      ".git/**",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "*.pem",
      "**/*.pem",
      "*.key",
      "**/*.key",
      "credentials*",
      "**/credentials*",
      "secrets/**",
      "**/secrets/**"
    ]
  },
  "limits": {
    "autonomous_max_changed_files": 5,
    "absolute_max_changed_files": 10,
    "autonomous_max_diff_lines": 400,
    "absolute_max_diff_lines": 800,
    "max_validation_attempts": 3,
    "max_model_format_retries": 2,
    "max_tree_entries": 500,
    "max_file_bytes": 65536,
    "max_search_results": 50,
    "max_context_bytes": 262144,
    "max_inspection_rounds": 8,
    "max_inspection_tool_calls": 12,
    "max_mcp_tool_timeout_seconds": 30,
    "max_task_timeout_seconds": 300,
    "max_task_output_bytes": 1048576,
    "max_validation_tasks_per_attempt": 6,
    "max_model_output_tokens": 8192,
    "max_active_runs": 4
  },
  "default_validation_tasks": ["javascript_syntax", "average_regression"],
  "validation_tasks": {
    "javascript_syntax": {
      "argv": ["node", "--check", "server.js"],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 65536,
      "retryable": false
    },
    "average_regression": {
      "argv": ["node", "--test", "tests/calculate-average.test.js"],
      "cwd": ".",
      "environment": {},
      "timeout_seconds": 60,
      "output_limit_bytes": 262144,
      "retryable": false
    }
  },
  "mandatory_tasks": [
    {
      "path_patterns": ["server.js", "lib/**", "tests/**"],
      "task_names": ["javascript_syntax", "average_regression"]
    }
  ],
  "artifacts": {
    "retention_days": 7,
    "write_audit_jsonl": true,
    "include_full_diff": true
  },
  "github": {
    "writes_enabled": true
  },
  "incident_memory": {
    "writes_enabled": false
  }
}
