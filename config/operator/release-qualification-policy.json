{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullOnlyRemediationImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:734849394833:repository/aios/remediation-agent"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "QualifyConfiguredModel",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeGateway",
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-1:734849394833:gateway/llm-gateway-with-inbound-auth-u8utldecju"
    },
    {
      "Sid": "QualifySystemInterpreter",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:StartCodeInterpreterSession",
        "bedrock-agentcore:InvokeCodeInterpreter",
        "bedrock-agentcore:StopCodeInterpreterSession"
      ],
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-1:aws:code-interpreter/aws.codeinterpreter.v1"
    },
    {
      "Sid": "StopOnlyQualificationRuntimeSessions",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:StopRuntimeSession",
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-1:734849394833:runtime/remediation_agent-2425SXH9D3/runtime-endpoint/DEFAULT"
    }
  ]
}
