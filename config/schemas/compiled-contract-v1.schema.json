{
  "$defs": {
    "RequestContract": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Content Type",
          "type": "string"
        },
        "evidence_paths": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Paths",
          "type": "array"
        },
        "example_body": {
          "default": "",
          "maxLength": 4000,
          "title": "Example Body",
          "type": "string"
        },
        "expected_responses": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Expected Responses",
          "type": "array"
        },
        "field_types": {
          "additionalProperties": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxProperties": 30,
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Field Types",
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^/[^\\s?#]*$",
          "title": "Path",
          "type": "string"
        },
        "prerequisites": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Prerequisites",
          "type": "array"
        },
        "state_changes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "State Changes",
          "type": "array"
        }
      },
      "required": [
        "method",
        "path",
        "content_type",
        "expected_responses",
        "evidence_paths"
      ],
      "title": "RequestContract",
      "type": "object"
    },
    "VerificationCriterion": {
      "additionalProperties": false,
      "description": "A proposed mapping; only deterministic execution can establish coverage.",
      "properties": {
        "criterion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 2000,
          "title": "Reason",
          "type": "string"
        },
        "scope": {
          "default": "LOCAL",
          "enum": [
            "LOCAL",
            "POST_DEPLOYMENT"
          ],
          "title": "Scope",
          "type": "string"
        },
        "task_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Name"
        },
        "test_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Test Ids",
          "type": "array"
        }
      },
      "required": [
        "criterion_id"
      ],
      "title": "VerificationCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertions": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "maxProperties": 50,
      "title": "Assertions",
      "type": "object"
    },
    "base_commit": {
      "minLength": 1,
      "title": "Base Commit",
      "type": "string"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/VerificationCriterion"
      },
      "maxItems": 20,
      "title": "Coverage",
      "type": "array"
    },
    "criteria": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 20,
      "title": "Criteria",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Limitations",
      "type": "array"
    },
    "policy_digest": {
      "minLength": 1,
      "title": "Policy Digest",
      "type": "string"
    },
    "request_contracts": {
      "items": {
        "$ref": "#/$defs/RequestContract"
      },
      "maxItems": 20,
      "title": "Request Contracts",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_digests": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 50,
      "title": "Task Digests",
      "type": "object"
    },
    "workflow_version": {
      "default": "remediation-v4",
      "enum": [
        "remediation-v3",
        "remediation-v4"
      ],
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "base_commit",
    "policy_digest",
    "criteria",
    "coverage",
    "task_digests"
  ],
  "title": "CompiledContractV1",
  "type": "object"
}
